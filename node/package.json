{
  "name": "packmem",
  "version": "0.1.0",
  "description": "An array of records in a fraction of the memory: packed columns you can still index, iterate and append to, filtered and aggregated without unpacking, and written to JSON without building objects.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/table.test.js test/pg.test.js"
  },
  "peerDependencies": {
    "pg-cursor": ">=2"
  },
  "peerDependenciesMeta": {
    "pg-cursor": {
      "optional": true
    }
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1"
  }
}
