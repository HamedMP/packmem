{
  "name": "packmem",
  "version": "0.1.1",
  "description": "An array of records in a fraction of the memory: packed columns you can still index, iterate and append to, filtered and aggregated without unpacking, and written to JSON without building objects.",
  "keywords": [
    "memory",
    "compression",
    "columnar",
    "json",
    "records",
    "napi",
    "postgres"
  ],
  "homepage": "https://hamedmp.github.io/packmem/",
  "bugs": {
    "url": "https://github.com/HamedMP/packmem/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamedMP/packmem.git",
    "directory": "node"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./wasm": {
      "types": "./wasm.d.ts",
      "default": "./wasm.js"
    },
    "./wasm/packmem.wasm": "./wasm-dist/packmem_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "api.js",
    "wasm.js",
    "wasm.d.ts",
    "wasm-dist/packmem.js",
    "wasm-dist/packmem_bg.wasm",
    "*.node",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/table.test.js test/review.test.js test/listops.test.js test/csv.test.js test/load.test.js test/wasm.test.js test/pg.test.js",
    "build:wasm": "node scripts/build-wasm.mjs"
  },
  "peerDependencies": {
    "pg-cursor": ">=2",
    "pg-copy-streams": ">=6"
  },
  "peerDependenciesMeta": {
    "pg-cursor": {
      "optional": true
    },
    "pg-copy-streams": {
      "optional": true
    }
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "pg-cursor": "^2.22.1"
  }
}
