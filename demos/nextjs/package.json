{
  "name": "packmem-demo-nextjs",
  "private": true,
  "type": "module",
  "scripts": {
    "refresh-packmem": "rm -rf node_modules/packmem && npm install --no-audit --no-fund",
    "dev": "next dev -H 127.0.0.1 -p 3002",
    "build": "npm run refresh-packmem && next build",
    "start": "next start -H 127.0.0.1 -p 3002",
    "start:baseline": "MODE=baseline next start -H 127.0.0.1 -p 3002"
  },
  "dependencies": {
    "next": "16.4.6",
    "packmem": "file:../../node",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
